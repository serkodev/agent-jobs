{
  "name": "batch-tasks-agent",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Bootstrap and run reusable batch tasks with native Codex and Claude subagents",
  "bin": {
    "batch-tasks": "dist/batch-tasks.mjs"
  },
  "files": [
    "dist/batch-tasks.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "batch-tasks": "node dist/batch-tasks.mjs",
    "build": "pnpm typecheck && vite build",
    "prepack": "pnpm build",
    "test:bundle": "pnpm build && node scripts/verify-bundle.mjs",
    "typecheck": "pnpm --filter @batch-tasks/runtime typecheck && tsc --noEmit",
    "test": "pnpm --filter @batch-tasks/runtime test && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@batch-tasks/runtime": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
