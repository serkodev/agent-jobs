{
  "name": "batch-tasks-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A resumable, schema-driven batch task runtime for native Codex subagents",
  "engines": {
    "node": ">=20.6"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "batch-tasks": "node --import tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.6.0",
    "json-with-bigint": "^3.5.10",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
