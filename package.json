{
  "name": "agent-jobs",
  "type": "module",
  "version": "0.0.0-alpha.0",
  "packageManager": "pnpm@11.19.0",
  "description": "Run resumable, schema-validated batch jobs with agents",
  "author": "SerKo",
  "license": "MIT",
  "homepage": "https://github.com/serkodev/agent-jobs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serkodev/agent-jobs.git"
  },
  "bugs": {
    "url": "https://github.com/serkodev/agent-jobs/issues"
  },
  "keywords": [
    "ai-agents",
    "batch-processing",
    "claude",
    "cli",
    "codex",
    "mcp"
  ],
  "bin": {
    "agent-jobs": "dist/agent-jobs.mjs"
  },
  "files": [
    "README.md",
    "dist/agent-jobs.mjs"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "agent-jobs": "node dist/agent-jobs.mjs",
    "build": "pnpm db:check && pnpm typecheck && vite build",
    "db:check": "node scripts/embed-migrations.mjs --check",
    "db:embed": "node scripts/embed-migrations.mjs",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts && pnpm db:embed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "pnpm build",
    "test:bundle": "pnpm build && node scripts/verify-bundle.mjs",
    "typecheck": "pnpm --filter @agent-jobs/runtime typecheck && tsc --noEmit",
    "test": "pnpm --filter @agent-jobs/runtime test && vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0"
  },
  "devDependencies": {
    "@agent-jobs/runtime": "workspace:*",
    "@antfu/eslint-config": "^9.3.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
