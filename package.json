{
  "name": "agent-jobs",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Run resumable, schema-validated agent jobs with native Codex and Claude workers",
  "bin": {
    "agent-jobs": "dist/agent-jobs.mjs"
  },
  "files": [
    "dist/agent-jobs.mjs",
    "README.md"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "agent-jobs": "node dist/agent-jobs.mjs",
    "build": "pnpm typecheck && vite build",
    "prepack": "pnpm build",
    "test:bundle": "pnpm build && node scripts/verify-bundle.mjs",
    "typecheck": "pnpm --filter @agent-jobs/runtime typecheck && tsc --noEmit",
    "test": "pnpm --filter @agent-jobs/runtime test && vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@agent-jobs/runtime": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.0",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  }
}
